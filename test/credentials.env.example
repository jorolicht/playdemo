# Zugangsdaten für die Shell-Testskripte unter test/ (API, admin, misc, tourney).
# Kopieren nach test/credentials.env und echte Werte eintragen; test/credentials.env wird nicht eingecheckt.
# TEST_WP_PASSWORD ist ein WordPress-Anwendungspasswort (Benutzer → Profil → Anwendungspasswörter).
TEST_WP_USER="admin"
TEST_WP_PASSWORD="xxxx xxxx xxxx xxxx xxxx xxxx"
