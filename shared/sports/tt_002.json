      },
      "teamSize": 2,
      "maxPlayers": 3,
      "defaultSystem": "bundes",
      "systems": [
        {
          "id": "bundes",
          "name": {
            "de": {
              "one": "Bundessystem (Werner-Scheffler)"
            },
            "en": {
              "one": "Federal system (Werner Scheffler)"
            }
          },
          "description": {
            "de": "Das im offiziellen Spielbetrieb am weitesten verbreitete System für 2er-Mannschaften (z. B. in Verbands- und Pokalspielen). Es sorgt für eine faire Lastenverteilung und garantiert mehrere Spiele.\n\nJede Mannschaft stellt 2 Spieler (A1, A2 gegen B1, B2). Gespielt werden 4 Einzel und 1 Doppel; das Doppel ist das dritte Spiel.\n\nEs wird gespielt, bis eine Mannschaft 3 Punkte erreicht hat. Die Begegnung kann also nach 3, 4 oder 5 Spielen beendet sein.",
            "en": "The most widely used system for teams of two in official play (e.g. league and cup matches). It spreads the load fairly and guarantees several matches.\n\nEach team fields 2 players (A1, A2 against B1, B2). 4 singles and 1 doubles are played; the doubles is the third match.\n\nPlay continues until one team has 3 points, so the tie can end after 3, 4 or 5 matches."
          },
          "level": {
            "id": "encounter",
            "kind": "bestOf",
            "toWin": 3,
            "unit": "match",
            "name": {
              "de": {
                "one": "Begegnung",
                "other": "Begegnungen",
                "short": "Bg"
              },
              "en": {
                "one": "Tie",
                "other": "Ties",
                "short": "T"
              }
            }
          },
          "variants": {
            "firstTo3": {
              "name": {
                "de": {
                  "one": "Bis 3 Punkte"
                },
                "en": {
                  "one": "First to 3 points"
                }
              },
              "override": {}
            },
            "all": {
