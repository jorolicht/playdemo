
###
# Dialog
###
DlgPrompt.title            = Konsole
DlgPrompt.plh.command      = <command> <parameter>

DlgStageStart.title = Neuen Wettbewerbsabschnitt starten
DlgStageStart.name_label = Name des Wettbewerbsabschnitts
DlgStageStart.name_placeholder = z.B. Vorrunde Gruppe A
DlgStageStart.pref_label = Nachfolgender Wettbewerbsabschnitt von:
DlgStageStart.pref_placeholder = -- Bitte vorherigen Wettbewerbsabschnitt auswählen --
DlgStageStart.start_notice = Hinweis: Start-Wettbewerbsabschnitt (erster Wettbewerbsabschnitt für diesen Wettbewerb).
DlgStageStart.cancel = Abbrechen
DlgStageStart.start = Start
DlgStageStart.err_name = Bitte geben Sie einen gültigen Namen für den Wettbewerbsabschnitt ein.
DlgStageStart.err_exists = Ein Wettbewerbsabschnitt mit diesem Namen existiert bereits in diesem Wettbewerb.
DlgStageStart.err_pref = Bitte wählen Sie einen vorherigen Wettbewerbsabschnitt aus.

DlgAddSingle.title = Teilnehmer hinzufügen
DlgAddSingle.title_player = Spieler neu anlegen
DlgAddDouble.new_player = Spieler neu anlegen
DlgAddSingle.lastname = Nachname
DlgAddSingle.firstname = Vorname
DlgAddSingle.club = Verein
DlgAddSingle.ttr = TTR-Wert
DlgAddSingle.ttr_placeholder = z.B. 1450
DlgAddSingle.year = Jahrgang
DlgAddSingle.year_unknown = -- Unbekannt --
DlgAddSingle.action = Aktion
DlgAddSingle.act_reg = Nur Registrieren (Inaktiv)
DlgAddSingle.act_play = Registrieren und Anmelden (Aktiv)
DlgAddSingle.cancel = Abbrechen
DlgAddSingle.save = Speichern
DlgAddSingle.err_fill = Bitte Name, Vorname und Verein ausfüllen.
DlgAddSingle.email = E-Mail
DlgAddSingle.whatsapp = WhatsApp-Nummer


DlgCsvInfo.title = CSV-Format für den Upload
DlgCsvInfo.file_title = Datei
DlgCsvInfo.file_1 = Textdatei mit Endung .csv, Zeichensatz UTF-8 (z. B. „CSV UTF-8“ beim Speichern in Excel).
DlgCsvInfo.file_2 = Trennzeichen Semikolon (;) oder Komma (,), es wird an der ersten Zeile erkannt.
DlgCsvInfo.file_3 = Die erste Zeile ist immer die Kopfzeile mit den Spaltennamen und wird nicht importiert.
DlgCsvInfo.cols_title = Spalten
DlgCsvInfo.col_header = Spaltenname
DlgCsvInfo.col_alt = alternativ
DlgCsvInfo.col_content = Inhalt
DlgCsvInfo.col_first = Vorname des Spielers (Pflicht)
DlgCsvInfo.col_last = Nachname des Spielers (Pflicht)
DlgCsvInfo.col_club = Verein (Pflicht); unbekannte Vereine werden angelegt
DlgCsvInfo.col_ttr = TTR-Wert als ganze Zahl (optional, darf leer bleiben)
DlgCsvInfo.col_year = Geburtsjahr, vierstellig (optional; auch „Geburtsjahr“)
DlgCsvInfo.col_email = E-Mail-Adresse (optional)
DlgCsvInfo.col_whatsapp = WhatsApp-Nummer (optional)
DlgCsvInfo.col_team = Name der Mannschaft (optional, nur Mannschaftswettbewerb). Alle Zeilen mit gleichem Namen bilden eine Mannschaft; die Reihenfolge der Zeilen ergibt die Positionen (Stammspieler, dann Ersatz).
DlgCsvInfo.col_team_club = Verein der Mannschaft (optional); es genügt die Angabe in einer Zeile der Mannschaft.
DlgCsvInfo.example_team_title = Beispiel Mannschaften
DlgCsvInfo.cols_hint = Groß-/Kleinschreibung der Spaltennamen ist egal, die Reihenfolge beliebig. Werden die Spaltennamen nicht erkannt, gilt die Reihenfolge Vorname, Nachname, Verein, TTR. Jahrgang, E-Mail und WhatsApp werden nur über den Spaltennamen erkannt. Ungültige Werte (Jahrgang keine Jahreszahl, E-Mail ohne @) bleiben leer. Weitere Spalten werden ignoriert.
DlgCsvInfo.example_title = Beispiel
DlgCsvInfo.proc_title = Verarbeitung
DlgCsvInfo.proc_1 = Zeilen ohne Vorname, Nachname oder Verein werden übersprungen.
DlgCsvInfo.proc_2 = Gibt es im Turnier schon einen Spieler mit gleichem Vor- und Nachnamen, wird er nicht neu angelegt; angegebene Werte für TTR, Jahrgang, E-Mail und WhatsApp werden übernommen.
DlgCsvInfo.proc_3 = Trennzeichen innerhalb eines Werts (z. B. Komma im Vereinsnamen bei Komma-Trennung) und Anführungszeichen werden nicht unterstützt.
DlgCsvInfo.mode_single = Einzel: Die Spieler werden im Turnier angelegt und im Wettbewerb gemeldet (noch nicht aktiv). Die Teilnahme wird danach über das Häkchen „Teilnahme“ gesetzt.
DlgCsvInfo.mode_double = Doppel/Mixed: Die Spieler werden nur im Turnier angelegt. Die Doppel werden danach über „+ Doppel hinzufügen“ gebildet.
DlgCsvInfo.mode_team = Mannschaft: Die Spieler werden im Turnier angelegt. Mit der Spalte „Mannschaft“ werden die Mannschaften gleich gebildet und gemeldet (eine vorhandene Mannschaft gleichen Namens wird ersetzt); ohne sie werden die Mannschaften danach über „+ Mannschaft hinzufügen“ gebildet.
DlgCsvInfo.ok = Verstanden
