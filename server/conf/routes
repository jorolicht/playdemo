# Routes
# This file defines all application routes (Higher priority routes first)
# ~~~~

# DSGVO Map Proxy Endpoints (Alternative 3: Serverseitige Aufbereitung / Karten-Kacheln)
GET        /api/map/tile/:z/:x/:y        controllers.MapController.tile(z: Int, x: Int, y: Int)
GET        /api/map/geocode              controllers.MapController.geocode(query: String)
GET        /api/map/static               controllers.MapController.staticMap(lat: Option[Double], lon: Option[Double], query: Option[String], zoom: Option[Int])

# Helper endpoints
GET        /helper/getMessages           controllers.Helper.getMessages(lang: String ?="")
GET        /helper/getMsg                controllers.Helper.getMsg(msgCode: String, in1:String ?="", in2:String ?="", in3:String ?="")
POST       /helper/clicktt-to-json       controllers.Helper.convertClickTT()

GET        /helper/send2sse              controllers.Helper.send2sse(id: String, msg: String)

# Hello endpoint
GET        /hello                        controllers.Helper.hello(msg: String)

# Referee endpoints
GET        /referee                      controllers.RefereeController.input(slug: String, tourneyName: String, competition: String, stage: String, roundInfo: String, players: String, winSets: Int ?= 3)
+ nocsrf
POST       /referee/submit               controllers.RefereeController.submit()

# Matchboard endpoints
GET        /matchboard/view/:slug        controllers.MatchboardController.view(slug: String)
+ nocsrf
POST       /matchboard/get               controllers.MatchboardController.get(slug: String)
+ nocsrf
POST       /matchboard/set               controllers.MatchboardController.set(slug: String)

# WebSocket endpoints
GET        /ws/:slug                     controllers.WebSocketController.socket(slug: String)
GET        /sendmsg                      controllers.WebSocketController.sendmsg(slug: String, msg: String)

# Endpoints managing wordpress custom post types
GET          /wp/post                    controllers.Wordpress.getPost(slug: String ?="", id: Int ?=0, field: String ?="", status: String ?="private")
PUT          /wp/post                    controllers.Wordpress.putPost(slug: String ?="", id: Int ?=0, field: String ?="", status: String ?="private")

